# Unity generated folders — never commit these.
# Note: .meta files ARE committed (Unity tracks asset references through them).
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset Store tools
/[Aa]ssets/AssetStoreTools*

# Autogenerated VS/Rider/VS Code files
.vs/
.idea/
.vscode/
ExportedObj/
.consulo/
*.csproj
# ...except the tracked headless test project, which is the whole point of
# `dotnet test` working on a fresh clone (tests/Match3.Core.Tests).
!tests/**/*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Build output of the tracked headless test project (the Unity rules above are
# root-anchored, so they do not cover tests/).
tests/**/bin/
tests/**/obj/

# Unity3D generated meta files for ignored content
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Signing material — losing this file means never updating the listing again, and
# committing it means anyone can. Neither. See docs/RELEASE.md.
*.keystore
*.jks

# Crashlytics
crashlytics-build.properties

# macOS
.DS_Store
